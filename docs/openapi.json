  "components": {
    "schemas": {
      "BuzzerTestRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "beep",
              "chirp",
              "alarm",
              "pulse",
              "off"
            ],
            "title": "Action",
            "description": "Acoustic pattern",
            "default": "beep"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000.0,
                "minimum": 10.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms",
            "description": "Tone duration",
            "default": 150
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Count",
            "description": "Repetition count",
            "default": 1
          },
          "interval_ms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2000.0,
                "minimum": 10.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Ms",
            "description": "Pause between repetitions",
            "default": 100
          }
        },
        "type": "object",
        "title": "BuzzerTestRequest",
        "description": "Request body for POST /api/v1/buzzer/test."
      },
      "CameraControlRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "move",
              "jog",
              "center",
              "speed"
            ],
            "title": "Action",
            "description": "Control operation",
            "default": "move"
          },
          "pan": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pan",
            "description": "Absolute target pan angle [15.0, 165.0]"
          },
          "tilt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tilt",
            "description": "Absolute target tilt angle [60.0, 135.0]"
          },
          "delta_pan": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delta Pan",
            "description": "Relative pan jog increment (max +-45.0)"
          },
          "delta_tilt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delta Tilt",
            "description": "Relative tilt jog increment (max +-30.0)"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.1
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed",
            "description": "Movement speed factor [0.1, 1.0]"
          }
        },
        "type": "object",
        "title": "CameraControlRequest",
        "description": "Request body for POST /api/v1/camera/control."
      },
      "CameraStatus": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running",
            "default": false
          },
          "fps": {
            "type": "number",
            "title": "Fps",
            "default": 0.0
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": false
          },
          "width": {
            "type": "integer",
            "title": "Width",
            "default": 640
          },
          "height": {
            "type": "integer",
            "title": "Height",
            "default": 480
          },
          "dropped_frames": {
            "type": "integer",
            "title": "Dropped Frames",
            "default": 0
          }
        },
        "type": "object",
        "title": "CameraStatus"
      },
      "ESP32Status": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected",
            "default": false
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          },
          "connected_at_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connected At Ms"
          },
          "last_heartbeat_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Heartbeat Ms"
          },
          "rtt_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rtt Ms"
          },
          "failsafe_active": {
            "type": "boolean",
            "title": "Failsafe Active",
            "default": false
          },
          "estop_active": {
            "type": "boolean",
            "title": "Estop Active",
            "default": false
          }
        },
        "type": "object",
        "title": "ESP32Status"
      },
      "EstopRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "freeze",
              "center",
              "release_pwm",
              "resume",
              "reset"
            ],
            "title": "Action",
            "description": "Safe-stop action or resume",
            "default": "freeze"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Reason for triggering safe stop",
            "default": "operator_e_stop"
          },
          "release_pwm": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Pwm",
            "description": "Depower servo coils",
            "default": false
          }
        },
        "type": "object",
        "title": "EstopRequest",
        "description": "Request body for POST /api/v1/system/estop."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "uptime_s": {
            "type": "number",
            "title": "Uptime S"
          },
          "timestamp": {
            "type": "integer",
            "title": "Timestamp"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "uptime_s",
          "timestamp",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Response model for GET /api/v1/health."
      },
      "StandardResponse": {
        "properties": {
